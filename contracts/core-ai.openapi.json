{
  "openapi": "3.1.0",
  "info": {
    "title": "EKL Core–AI internal API",
    "version": "1"
  },
  "paths": {
    "/internal/parse": {
      "post": {
        "summary": "Parse",
        "operationId": "parse_internal_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid service token"
          },
          "408": {
            "description": "Invalid or expired deadline"
          },
          "409": {
            "description": "Replayed nonce"
          },
          "411": {
            "description": "Content-Length required"
          },
          "413": {
            "description": "Request exceeds limits"
          },
          "503": {
            "description": "Service temporarily unavailable"
          },
          "504": {
            "description": "Parser deadline exceeded"
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    },
    "/internal/generate": {
      "post": {
        "summary": "Generate",
        "operationId": "generate_internal_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid service token"
          },
          "408": {
            "description": "Invalid or expired deadline"
          },
          "409": {
            "description": "Replayed nonce"
          },
          "411": {
            "description": "Content-Length required"
          },
          "413": {
            "description": "Request exceeds limits"
          },
          "503": {
            "description": "Service temporarily unavailable"
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "title": "Deadline"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "context": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Context"
          },
          "source_map": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Source Map"
          },
          "token_budget": {
            "type": "integer",
            "maximum": 8192.0,
            "minimum": 1.0,
            "title": "Token Budget"
          },
          "prompt_version_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Prompt Version Id"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "schema_version",
          "deadline",
          "nonce",
          "context",
          "source_map",
          "token_budget",
          "prompt_version_id"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citation_keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citation Keys"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "mode": {
            "type": "string",
            "enum": [
              "DUMMY",
              "MODEL"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citation_keys",
          "usage",
          "mode"
        ],
        "title": "GenerateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ParseRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "title": "Deadline"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "task_id": {
            "type": "string",
            "format": "uuid",
            "title": "Task Id"
          },
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "title": "Artifact Id"
          },
          "config_version": {
            "type": "string",
            "const": "document-parser-v1",
            "title": "Config Version"
          },
          "mime": {
            "type": "string",
            "enum": [
              "application/pdf",
              "text/plain",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ],
            "title": "Mime"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 13981016,
            "minLength": 4,
            "title": "Content Base64"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "schema_version",
          "deadline",
          "nonce",
          "task_id",
          "artifact_id",
          "config_version",
          "mime",
          "content_base64"
        ],
        "title": "ParseRequest"
      },
      "ParseResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PARSED",
              "OCR_REQUIRED",
              "QUALITY_FAILED"
            ],
            "title": "Status"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "title": "Segments"
          }
        },
        "type": "object",
        "required": [
          "status",
          "segments"
        ],
        "title": "ParseResponse"
      },
      "Segment": {
        "properties": {
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "paragraph": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paragraph"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "page",
          "paragraph",
          "text"
        ],
        "title": "Segment"
      },
      "Usage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "title": "Usage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
